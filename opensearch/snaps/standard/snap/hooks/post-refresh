#!/usr/bin/env bash

set -eux

source "${OPS_ROOT}"/helpers/snap-logger.sh "hook-post-refresh"
source "${OPS_ROOT}"/helpers/set-conf.sh

function as_snap_daemon () {
    setpriv \
        --clear-groups \
        --reuid snap_daemon \
        --regid snap_daemon -- \
        "$@"
}

# Modules and libraries only come from the distribution: replace them all.
replace_stale_jars() {
    local dir
    for dir in modules lib; do
        as_snap_daemon "${SNAP}/usr/bin/rsync" -a --delete \
            "${SNAP}/usr/share/opensearch/${dir}/" \
            "${OPENSEARCH_HOME}/${dir}/"
    done
}

# Install the plugins bundled with this revision, remove those it no longer
# bundles, and keep the custom plugins this revision's OpenSearch can load.
refresh_plugins() {
    local bundled_dir="${SNAP}/usr/share/opensearch/plugins"
    local plugins_dir="${OPENSEARCH_HOME}/plugins"
    local bundled_list="${OPENSEARCH_HOME}/.bundled-plugins"
    local removal_list plugin_path name
    local -a previously_bundled=() custom_plugin_paths=()

    # Written by the install or post-refresh hook of the previous revision.
    # Older revisions wrote none: they bundled the same plugins as this one.
    if [ -f "${bundled_list}" ]; then
        mapfile -t previously_bundled < "${bundled_list}"
    fi

    removal_list="$(mktemp "${SNAP_DATA}/plugin-removal.XXXXXXXX")"
    for plugin_path in "${plugins_dir}"/*; do
        [ -e "${plugin_path}" ] || [ -L "${plugin_path}" ] || continue
        name="${plugin_path##*/}"

        # This revision's copy replaces it below, as for a custom copy of it.
        [ -d "${bundled_dir}/${name}" ] && continue

        if printf '%s\n' "${previously_bundled[@]}" | grep -qxF -- "${name}"; then
            printf '%s\0' "${plugin_path}" >> "${removal_list}"
        else
            custom_plugin_paths+=("${plugin_path}")
        fi
    done

    # Check custom plugins with this revision's OpenSearch classes: a plugin
    # it cannot load stops the node. If the check fails, unload them all.
    if [ "${#custom_plugin_paths[@]}" -gt 0 ]; then
        # Hooks cannot resolve the host name: keep log4j's own lookup error
        # out of the hook log, it does not affect the check.
        if ! as_snap_daemon "${JAVA_HOME}/bin/java" \
            -Dlog4j2.statusLoggerLevel=OFF \
            --class-path "${SNAP}/usr/share/opensearch/lib/*" \
            "${SNAP}/opt/opensearch/helpers/CheckPluginCompatibility.java" \
            "${bundled_dir}" "${SNAP}/usr/share/opensearch/modules" \
            "${custom_plugin_paths[@]}" >> "${removal_list}"; then
            echo "Plugin checker failed; unloading all unverified custom plugins from this revision." >&2
            printf '%s\0' "${custom_plugin_paths[@]}" >> "${removal_list}"
        fi
    fi

    # Only this revision's copy is removed: a revert finds the plugin again.
    while IFS= read -r -d '' plugin_path; do
        name="${plugin_path##*/}"
        as_snap_daemon rm -rf -- "${plugins_dir}/${name}" "${OPENSEARCH_HOME}/bin/${name}"
        echo "Unloaded ${name} from revision ${SNAP_REVISION}; its previous-revision files remain available for revert."
    done < "${removal_list}"
    rm -f -- "${removal_list}"

    for plugin_path in "${bundled_dir}"/*/; do
        name="$(basename "${plugin_path}")"
        if [ -L "${plugins_dir}/${name}" ]; then
            as_snap_daemon rm -f -- "${plugins_dir}/${name}"
        fi
        as_snap_daemon "${SNAP}/usr/bin/rsync" -a --delete \
            "${plugin_path}" "${plugins_dir}/${name}/"
    done

    find "${bundled_dir}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort \
        | as_snap_daemon tee "${bundled_list}" > /dev/null
}

replace_stale_jars
refresh_plugins

# Restore the active snap's bundled CAs while retaining separately named custom CAs.
bash "${OPS_ROOT}/helpers/refresh-trust-store.sh" refresh

# As on install, writable by root through the group: sudo opensearch.keytool
# manages it. Older installs left it read-only. Its owner (snap_daemon) changes
# the mode: root lacks the capability to do it under confinement.
setpriv \
    --clear-groups \
    --reuid snap_daemon \
    --regid snap_daemon -- \
    chmod 660 "${OPENSEARCH_PATH_CERTS}/cacerts.p12"

# Migrate the upstream heap-dump default; preserve any path chosen by the operator.
replace_in_file "${OPENSEARCH_PATH_CONF}/jvm.options" '^-XX:HeapDumpPath=data$' "-XX:HeapDumpPath=${OPENSEARCH_VARLOG}/java_heapdump.hprof"
