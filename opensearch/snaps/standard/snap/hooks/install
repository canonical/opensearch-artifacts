#!/usr/bin/env bash

set -eux


source "${OPS_ROOT}"/helpers/io.sh
source "${OPS_ROOT}"/helpers/set-conf.sh
source "${OPS_ROOT}"/sys/set-sys-config.sh


function create_file_structure () {

    # want to use the * here, so not calling dir_copy_if_not_exists
    # Doing it before OPENSEARCH_PATH_CERTS is created, as it is set as "snap_daemon" user
    mkdir -p "${OPENSEARCH_PATH_CONF}/"
    copy_files_between_folder "${SNAP}/etc/opensearch/" "${OPENSEARCH_PATH_CONF}/"
    chown snap_daemon "${OPENSEARCH_PATH_CONF}"
    chgrp root "${OPENSEARCH_PATH_CONF}"

    # The upstream opensearch.yml template is all comments (no YAML data).
    # python yq silently truncates such files. Prepend a YAML document
    # separator so yq has valid YAML to operate on.
    if ! grep -q "^---$" "${OPENSEARCH_PATH_CONF}/opensearch.yml"; then
        sed -i "1i ---" "${OPENSEARCH_PATH_CONF}/opensearch.yml"
    fi

    declare -a folders=("${OPENSEARCH_VARLIB}" "${OPENSEARCH_VARLOG}" "${OPENSEARCH_TMPDIR}" "${OPENSEARCH_PATH_CERTS}" "${HOME}")
    for f in "${folders[@]}"; do
        if [ ! -d "${f}" ]; then
            add_folder "${f}" 770
        fi
    done

    local data_home="${SNAP_DATA}/usr/share/opensearch"
    local plugins_dir="${data_home}/plugins"
    add_folder "${data_home}" 770
    add_folder "${plugins_dir}" 770
    local plugin
    local name
    for plugin in "${SNAP}"/usr/share/opensearch/shipped-plugins/*/; do
        [ -d "${plugin}" ] || continue
        name="$(basename "${plugin}")"
        ln -s \
            "${SNAP_CURRENT}/usr/share/opensearch/shipped-plugins/${name}" \
            "${plugins_dir}/"
    done

    # Writable bin/ for the scripts that plugins ship, next to the shipped ones
    local bin_dir="${data_home}/bin"
    local script
    add_folder "${bin_dir}" 770
    for script in "${SNAP}"/usr/share/opensearch/shipped-bin/*; do
        ln -s \
            "${SNAP_CURRENT}/usr/share/opensearch/shipped-bin/$(basename "${script}")" \
            "${bin_dir}/"
    done

    add_folder "${OPENSEARCH_EXTENSIONS}" 770
    add_file "${OPENSEARCH_EXTENSIONS}/extensions.yml" 660
    add_file "${OPENSEARCH_PATH_CONF}/unicast_hosts.txt" 660
    [ -d "/dev/shm/performanceanalyzer" ] || add_folder "/dev/shm/performanceanalyzer" 770
}


function set_base_config_props () {
    set_yaml_prop "${OPENSEARCH_PATH_CONF}/opensearch.yml" "path.data" "${OPENSEARCH_VARLIB}"
    set_yaml_prop "${OPENSEARCH_PATH_CONF}/opensearch.yml" "path.logs" "${OPENSEARCH_VARLOG}"
    set_yaml_prop "${OPENSEARCH_PATH_CONF}/opensearch.yml" "path.home" "${OPENSEARCH_HOME}"

    replace_in_file "${OPENSEARCH_PATH_CONF}/jvm.options" "=logs/" "=${OPENSEARCH_VARLOG}/"
    replace_in_file "${OPENSEARCH_PATH_CONF}/jvm.options" "-javaagent:" "-javaagent:${SNAP_CURRENT}/usr/share/opensearch/"
    echo "-Duser.home=${HOME}" | tee -a "${OPENSEARCH_PATH_CONF}/jvm.options"
}


function create_editable_cacerts_trust_store() {
    # Copy the read only JDK provided cacerts into a writeable one
    "${JAVA_HOME}"/bin/keytool \
        -importkeystore                                     \
        -srckeystore  "${SNAP}/etc/ssl/certs/java/cacerts"  \
        -destkeystore "${OPENSEARCH_PATH_CERTS}/cacerts.p12" \
        -srcstoretype   JKS              \
        -deststoretype  PKCS12           \
        -srcstorepass   changeit         \
        -deststorepass  changeit         \
        -noprompt

    # writable by root through the group: sudo opensearch.keytool manages it
    set_access_restrictions "${OPENSEARCH_PATH_CERTS}/cacerts.p12" 660

    echo "-Djavax.net.ssl.trustStore=${OPENSEARCH_PATH_CERTS}/cacerts.p12" | tee -a "${OPENSEARCH_PATH_CONF}/jvm.options"
    echo "-Djavax.net.ssl.trustStorePassword=changeit" | tee -a "${OPENSEARCH_PATH_CONF}/jvm.options"
}

# Replace the well-known default passwords of the internal users (admin,
# kibanaserver, ...) with random ones, stored root-only in
# ${SNAP_COMMON}/init_users_pass.yaml as '<user>: "<password>"' lines.
# Runs before the first start, which creates the security index from
# internal_users.yml.
function set_initial_passwords () {
    local internal_users="${OPENSEARCH_PATH_CONF}/opensearch-security/internal_users.yml"
    local passwords_file="${SNAP_COMMON}/init_users_pass.yaml"
    local user hash
    local -a users

    mapfile -t users < <("${SNAP}"/usr/bin/yq -r 'keys[] | select(. != "_meta")' "${internal_users}")

    (umask 077 && : > "${passwords_file}")
    chown root:root "${passwords_file}"
    chmod 600 "${passwords_file}"

    for user in "${users[@]}"; do
        # keep the password out of the xtrace output
        { set +x; } 2>/dev/null

        USER_PWD=$(openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32; echo)
        if [ "${#USER_PWD}" -ne 32 ]; then
            echo "ERROR: could not generate the initial password of ${user}." >&2
            exit 1
        fi
        export USER_PWD
        hash="$(bash "${OPENSEARCH_PLUGINS}"/opensearch-security/tools/hash.sh -env USER_PWD)"
        if ! [[ "${hash}" =~ ^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]]; then
            echo "ERROR: could not hash the initial password of ${user}." >&2
            exit 1
        fi

        # quoted: an all-digit password must stay a string
        printf '%s: "%s"\n' "${user}" "${USER_PWD}" >> "${passwords_file}"
        unset USER_PWD
        set -x

        "${SNAP}"/usr/bin/yq -y -i --arg u "${user}" --arg h "${hash}" \
            '.[$u].hash = $h' "${internal_users}"
    done
}

function bootstrap_cluster () {
    # Defaults for a ready-to-use single-node cluster.
    local cluster_name="opensearch-cluster"
    local node_name="opensearch-$(hostname)"

    local opensearch_yaml="${OPENSEARCH_PATH_CONF}/opensearch.yml"
    set_yaml_prop "${opensearch_yaml}" "cluster.name" "${cluster_name}"
    set_yaml_prop "${opensearch_yaml}" "node.name" "${node_name}"
    set_yaml_list "${opensearch_yaml}" "network.host" "_local_" "_site_"
    set_yaml_list "${opensearch_yaml}" "discovery.seed_hosts" "127.0.0.1" "[::1]"
    set_yaml_list "${opensearch_yaml}" "cluster.initial_cluster_manager_nodes" "${node_name}"
    set_yaml_prop "${opensearch_yaml}" "plugins.security.disabled" "false"

    local TLS_DIR="${OPS_ROOT}/security/tls"
    source \
        "${TLS_DIR}"/self-managed-init.sh \
            --root-password "" \
            --admin-password "" \
            --root-subject "" \
            --admin-subject "" \
            --rest-with-tls "yes" \
            --target-dir "${OPENSEARCH_PATH_CERTS}"

    source \
        "${TLS_DIR}"/self-managed-node.sh \
            --name "${node_name}" \
            --root-password "" \
            --node-password "" \
            --node-subject "" \
            --rest-with-tls "yes" \
            --target-dir "${OPENSEARCH_PATH_CERTS}"

    keys=("root-ca" "root-ca-key" "admin" "admin-key" "node-${node_name}" "node-${node_name}-key")
    for key in "${keys[@]}"; do
        set_access_restrictions "${OPENSEARCH_PATH_CERTS}/${key}.pem" 660
    done

    set_initial_passwords

    # Let the security plugin create the .opendistro_security index
    set_yaml_prop \
        "${opensearch_yaml}" \
        "plugins.security.allow_default_init_securityindex" "true"
}


# Add logger after the permission check
source "${OPS_ROOT}"/helpers/snap-logger.sh "hook-install"
create_file_structure
set_base_config_props
create_editable_cacerts_trust_store

declare -a folders=("${OPENSEARCH_PATH_CONF}" "${SNAP_DATA}/usr/share/opensearch")
for f in "${folders[@]}"; do
    chown -R snap_daemon "${f}/"*
    chgrp -R root "${f}/"*
done

bootstrap_cluster
